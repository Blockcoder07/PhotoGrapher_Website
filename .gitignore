# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Env / secrets
.env
.env.local
.env.*.local

# Prisma
prisma/generated/

# Note: uploads/ and media/ are intentionally NOT ignored — server/'s wwwroot/uploads and
# wwwroot/media are both tracked in git too. Render's disk is ephemeral, so committing uploaded
# files is this project's actual (if unusual) way of persisting them across redeploys.

